// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users (Auth)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("student") // "student", "instructor", "admin" (legacy, use OrganizationRole now)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizationRoles OrganizationRole[]
  instructorClasses   ImprovClass[]
  improvEnrollments   ImprovEnrollment[]
  k12instructorClasses K12Class[]
  k12Enrollments      K12Enrollment[]
  resourcesCreated    StandardResource[] @relation("CreatedBy")
  teacherStandardAssignments TeacherStandardAssignment[]

  @@index([email])
}

// ============================================
// ORGANIZATIONS (Multi-Tenant Support)
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique // "Match High School", "Improv Asylum", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users             OrganizationRole[]
  improvClasses     ImprovClass[]
  k12Classes        K12Class[]
  standardsDistributions StandardsDistribution[]
  teacherStandardAssignments TeacherStandardAssignment[]

  @@index([name])
}

model OrganizationRole {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role String // "SuperAdmin" | "SchoolAdmin" | "GradeLeadAdmin" | "SchedulerAdmin" | "Teacher" | "Student"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([role])
}

// ============================================
// STANDARDS & RESOURCES BANK
// ============================================

model StandardsBank {
  id          String   @id @default(cuid())
  name        String   // "AP US History 2024"
  subject     String   // "History", "Science", "Math", etc.
  gradeLevel  String   // "11", "9-12", etc.
  description String?
  source      String?  // "AP", "Common Core", "Custom", etc.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  standards   Standard[]

  @@index([subject])
  @@index([gradeLevel])
}

model Standard {
  id            String   @id @default(cuid())
  standardsBankId String
  standardsBank StandardsBank @relation(fields: [standardsBankId], references: [id], onDelete: Cascade)

  code        String   // "2.1", "3.2", etc.
  name        String   // "Causes of Conflict"
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  resources   StandardResource[]
  exampleObjectives ExampleObjective[]
  distributions StandardsDistribution[]
  teacherAssignments TeacherStandardAssignment[]

  @@unique([standardsBankId, code])
  @@index([standardsBankId])
}

model ClassStandard {
  id        String   @id @default(cuid())
  classId   String
  // Will be linked to ImprovClass or K12Class via polymorphic pattern

  standardId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, standardId])
  @@index([classId])
}

model ExampleObjective {
  id          String   @id @default(cuid())
  standardId  String
  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  label       String   // "A", "B", "C", etc.
  text        String   // "Identify 3+ causes"
  description String?

  sequenceNum Int      // Order

  @@unique([standardId, label])
  @@index([standardId])
}

model StandardResource {
  id          String   @id @default(cuid())
  standardId  String
  standard    Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  type        String   // "material" | "assessment" | "tool"
  title       String
  description String?
  url         String?  // For external resources
  fileId      String?  // For uploaded files (Supabase/S3)
  format      String?  // "pdf", "video", "article", "worksheet", etc.

  objectiveLabels String? // Comma-separated: "A,B,C" (optional tagging to objectives)

  createdById String   // userId of creator (Super-Admin or Teacher)
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([standardId])
  @@index([type])
  @@index([createdById])
}

model StandardsDistribution {
  id              String   @id @default(cuid())
  standardId      String
  standard        Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status          String   @default("available") // "available" | "active" | "archived"

  distributedBy   String   // userId (Kyle/Super-Admin)
  distributedAt   DateTime @default(now())
  activatedAt     DateTime?

  @@unique([standardId, organizationId])
  @@index([organizationId])
  @@index([status])
}

model TeacherStandardAssignment {
  id              String   @id @default(cuid())
  teacherId       String
  teacher         User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  standardId      String
  standard        Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedBy      String   // userId (Org Admin)
  assignedAt      DateTime @default(now())

  @@unique([teacherId, standardId, organizationId])
  @@index([organizationId])
  @@index([teacherId])
}

// ============================================
// IMPROV MASTERY TRACKER SCHEMA (P1)
// ============================================

model ImprovClass {
  id          String   @id @default(cuid())
  name        String   // "Musical Improv Level 2"
  subtitle    String?  // "The Anti-Hero's Journey"

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  instructorId String
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  startDate   DateTime
  endDate     DateTime?
  numWeeks    Int      @default(8)
  status      String   @default("active") // "active", "archived", "draft"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  weeks       ImprovWeek[]
  enrollments ImprovEnrollment[]

  @@index([instructorId])
}

model ImprovEnrollment {
  id        String   @id @default(cuid())
  classId   String
  class     ImprovClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())
  status     String   @default("active") // "active", "dropped", "completed"
  role       String   @default("student")

  createdAt DateTime @default(now())

  // Relations
  studentRatings ImprovStudentRating[]
  teacherRatings ImprovTeacherRating[]
  feedback       ImprovFeedback[]

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
}

model ImprovWeek {
  id        String   @id @default(cuid())
  classId   String
  class     ImprovClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  weekNum   Int      // 1-24
  title     String?  // "Listening and Agreement"
  focusAreas String? // Markdown description

  sessionNotes        String?
  sessionNotesUpdatedAt DateTime?

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  weekSkills     ImprovWeekSkill[]
  studentRatings ImprovStudentRating[]
  teacherRatings ImprovTeacherRating[]
  feedback       ImprovFeedback[]

  @@unique([classId, weekNum])
  @@index([classId])
}

model ImprovSkill {
  id          String   @id @default(cuid())
  slug        String   @unique // "yes-and"
  name        String   // "Yes And"
  category    String   // "foundation", "scene-work", "musical"
  categoryIcon String?  // "◆", "▲", "●"
  categoryColor String? // "#D97706"

  description String?

  // JSON object with approaching, developing, proficient definitions
  levelDefinitions String? // Stored as JSON string

  isActive    Boolean  @default(true)
  version     Int      @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  retiredAt   DateTime?

  // Relations
  objectives      ImprovObjective[]
  weekSkills      ImprovWeekSkill[]
  studentRatings  ImprovStudentRating[]
  teacherRatings  ImprovTeacherRating[]
  feedback        ImprovFeedback[]

  @@index([isActive])
}

model ImprovObjective {
  id          String   @id @default(cuid())
  skillId     String
  skill       ImprovSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  sequenceNum Int      // Order within skill (1, 2, 3...)
  text        String   // Guiding question or learning target
  description String?
  examples    String?  // Markdown examples

  @@index([skillId])
}

model ImprovWeekSkill {
  id        String   @id @default(cuid())
  weekId    String
  week      ImprovWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  skillId   String
  skill     ImprovSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  isAnchor  Boolean  @default(true) // true = assessed this week
  sequenceNum Int    // Visual order in UI

  @@unique([weekId, skillId])
  @@index([weekId])
  @@index([skillId])
}

model ImprovStudentRating {
  id          String   @id @default(cuid())
  enrollmentId String
  enrollment  ImprovEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  weekId      String
  week        ImprovWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  skillId     String
  skill       ImprovSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  level       String   // "approaching", "developing", "proficient"
  narrative   String?  // Student's explanation
  evidence    String?  // Supporting work/context

  createdAt   DateTime @default(now())
  revisedAt   DateTime? // When student revised this rating

  @@unique([enrollmentId, weekId, skillId])
  @@index([enrollmentId])
  @@index([weekId])
  @@index([skillId])
}

model ImprovTeacherRating {
  id          String   @id @default(cuid())
  enrollmentId String
  enrollment  ImprovEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  weekId      String
  week        ImprovWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  skillId     String
  skill       ImprovSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  level       String   // "approaching", "developing", "proficient"
  instructorNotes String? // Internal teacher notes

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([enrollmentId, weekId, skillId])
  @@index([enrollmentId])
  @@index([weekId])
  @@index([skillId])
}

model ImprovFeedback {
  id          String   @id @default(cuid())
  enrollmentId String
  enrollment  ImprovEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  weekId      String
  week        ImprovWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  skillId     String?
  skill       ImprovSkill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  note        String   // Instructor feedback
  isVisible   Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enrollmentId])
  @@index([weekId])
  @@index([skillId])
}

// ============================================
// K-12 HUMANITIES MASTERY TRACKER SCHEMA (P2)
// ============================================

model K12Class {
  id          String   @id @default(cuid())
  name        String   // "American Lit, Period 3"

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  instructorId String
  instructor   User     @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  gradeLevel  String   // "9", "10", "11", "12"
  subject     String   // "literature", "writing", "history", "speech"

  startDate   DateTime
  endDate     DateTime?
  numUnits    Int      @default(8)
  status      String   @default("active")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations (for Phase 2)
  // units       K12Unit[]
  // enrollments K12Enrollment[]

  @@index([instructorId])
}

model K12Enrollment {
  id        String   @id @default(cuid())
  classId   String
  // class     K12Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())
  status     String   @default("active")

  createdAt DateTime @default(now())

  // Placeholder for Phase 2 rating models
  // studentRatings K12StudentRating[]
  // teacherRatings K12TeacherRating[]
  // feedback       K12Feedback[]

  @@unique([classId, studentId])
  @@index([studentId])
}
