import { NextRequest, NextResponse } from 'next/server';
import { getServerSession } from 'next-auth';
import { authOptions } from '@/app/api/auth/[...nextauth]/route';
import { prisma } from '@/lib/prisma';

export async function PUT(
  req: NextRequest,
  { params }: { params: Promise<{ slug: string; articleId: string }> }
) {
  try {
    const session = await getServerSession(authOptions);
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const { slug, toolId } = await params;
    const body = await req.json();

    const community = await prisma.learningCommunity.findUnique({
      where: { slug },
      select: { id: true, curatorId: true },
    });

    if (!community) {
      return NextResponse.json({ error: 'Community not found' }, { status: 404 });
    }

    const user = await prisma.user.findUnique({
      where: { email: session.user.email },
      select: { id: true },
    });

    if (!user || community.curatorId !== user.id) {
      return NextResponse.json(
        { error: 'Only community curator can update tools' },
        { status: 403 }
      );
    }

    const tool = await prisma.polymathTool.findUnique({
      where: { id: toolId },
      select: { communityId: true },
    });

    if (!tool || tool.communityId !== community.id) {
      return NextResponse.json({ error: 'Tool not found' }, { status: 404 });
    }

    const updateData: any = {};
    Object.keys(body).forEach((key) => {
      if (body[key] !== undefined) {
        updateData[key] = body[key];
      }
    });

    // Handle status changes
    if (body.status && body.status === 'published') {
      updateData.publishedAt = new Date();
    }

    const updated = await prisma.polymathTool.update({
      where: { id: toolId },
      data: updateData,
      include: {
        author: { select: { id: true, name: true, email: true } },
      },
    });

    return NextResponse.json(updated, { status: 200 });
  } catch (error) {
    console.error('[PUT /tools/[toolId]]', error);
    return NextResponse.json(
      { error: 'Failed to update tool' },
      { status: 500 }
    );
  }
}

export async function DELETE(
  req: NextRequest,
  { params }: { params: Promise<{ slug: string; articleId: string }> }
) {
  try {
    const session = await getServerSession(authOptions);
    if (!session?.user?.email) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const { slug, toolId } = await params;

    const community = await prisma.learningCommunity.findUnique({
      where: { slug },
      select: { id: true, curatorId: true },
    });

    if (!community) {
      return NextResponse.json({ error: 'Community not found' }, { status: 404 });
    }

    const user = await prisma.user.findUnique({
      where: { email: session.user.email },
      select: { id: true },
    });

    if (!user || community.curatorId !== user.id) {
      return NextResponse.json(
        { error: 'Only community curator can delete tools' },
        { status: 403 }
      );
    }

    const tool = await prisma.polymathTool.findUnique({
      where: { id: toolId },
      select: { communityId: true },
    });

    if (!tool || tool.communityId !== community.id) {
      return NextResponse.json({ error: 'Tool not found' }, { status: 404 });
    }

    await prisma.polymathTool.delete({
      where: { id: toolId },
    });

    return NextResponse.json({ success: true }, { status: 200 });
  } catch (error) {
    console.error('[DELETE /tools/[toolId]]', error);
    return NextResponse.json(
      { error: 'Failed to delete tool' },
      { status: 500 }
    );
  }
}
